# GreenRoute settings. Copy to .env (git-ignored) and fill in only what you need:
#     cp .env.example .env
# Empty values are ignored, so the code's defaults apply. Shell variables override this file.
# Never commit .env or paste keys into issues, chats or logs.

# --- Hugging Face (optional) ----------------------------------------------
# Only for gated models or higher download rate limits. Current models are not gated.
HF_TOKEN=

# --- Modal ----------------------------------------------------------------
# Normally set by `modal token new` (stored in ~/.modal.toml). Use these instead on CI
# or a shared machine.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Experiment settings ----------------------------------------------------
# Defaults differ per script (e.g. sprint0 uses A100-80GB), so leave these empty
# unless you want to change every script at once.
GREENROUTE_GPU=              # Modal GPU type, e.g. H100, A100-80GB, L4
GREENROUTE_GPUS_PER_RUN=     # > 1 splits each model over that many GPUs (tensor parallel)
GREENROUTE_MAX_GPUS=         # max Modal containers running at once
GREENROUTE_CPUS=             # CPUs per power-sweep container
GREENROUTE_PROVIDER=         # label recorded in results by run_local.py, e.g. runpod
GREENROUTE_PORT=             # vLLM server port for serve_bench (run_local sets it per GPU)

# --- Phase 2: model APIs (paused; used by branch claude/nervous-wing-e0d933) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MODAL_PROXY_TOKEN=           # Modal shared endpoints (Kimi, DeepSeek, GLM)
MODAL_ENDPOINT_BASE_URL=
OPENAI_COMPAT_API_KEY=       # any other OpenAI-compatible server
OPENAI_COMPAT_BASE_URL=
